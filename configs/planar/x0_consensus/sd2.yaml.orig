experiment: {name: planar-x0-consensus-sd2-ruins, seed: 0}
model:
  pipeline: sd2
  id: sd2-community/stable-diffusion-2-base
  variant: null
  precision: fp16
global_pipeline:
  mode: erp_x0_consensus
  clean_consensus: {bootstrap: native_noise, noise_storage: cpu, noise_binding: camera_index, noise_dtype: fp32}
canvas: {mode: planar}
planar:
  height: 2048
  width: 4096
  patch_size: 1024
  stride: 512
  patch_strategy: fixed
  dynamic_step_size: 64
  prompt_assignment: legacy_directional
prompt: {path: prompts/ruins.txt}
generation: {num_inference_steps: 20, guidance_scale: 7.5, batch_size: 1}
initialization: {mode: canvas_rgb_noise}
warp: {mode: standard}
fusion: {mode: average, weight_mode: uniform}
performance: {view_batch_size: 1, vae_chunk_size: 1}
output: {directory: outputs, group: planar-x0-consensus}
